# Copy this file to .env and fill in ONE of the two options below.
# Expo automatically loads .env at the project root and inlines any
# EXPO_PUBLIC_-prefixed variable into the JS bundle at build/start time.

# OPTION 1 — recommended: point at your deployed Cloudflare Worker proxy
# (see /server). The app never needs a 17TRACK API key in this mode.
EXPO_PUBLIC_TRACKING_PROXY_URL=https://trackly-tracking-proxy.<your-subdomain>.workers.dev

# OPTION 2 — simpler, less safe: call 17TRACK directly from the app with your
# own API key. Anything EXPO_PUBLIC_ is embedded in the compiled app and can
# be extracted from the APK — fine for a personal/hobby build, not otherwise.
# Leave EXPO_PUBLIC_TRACKING_PROXY_URL unset above if you use this instead.
# EXPO_PUBLIC_TRACKING_API_KEY=your-17track-api-key
