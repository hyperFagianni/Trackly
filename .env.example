# Copy this file to .env and fill in what you need. Expo automatically loads
# .env at the project root and inlines any EXPO_PUBLIC_-prefixed variable into
# the JS bundle at build/start time.
#
# You only need to configure the carriers you actually want live tracking
# for (UPS, FedEx, DHL) — see README "Dati di tracciamento". Everything else
# in the app works with none of these set; those specific shipments just show
# "API non configurata" instead of a live status.

# OPTION 1 — recommended: point at your deployed Cloudflare Worker proxy
# (see /server). The app never needs the carriers' credentials directly in
# this mode.
EXPO_PUBLIC_TRACKING_PROXY_URL=https://trackly-tracking-proxy.<your-subdomain>.workers.dev

# OPTION 2 — simpler, less safe: call each carrier directly from the app with
# your own credentials. Anything EXPO_PUBLIC_ is embedded in the compiled app
# and can be extracted from the APK — fine for a personal/hobby build, not
# otherwise. Leave EXPO_PUBLIC_TRACKING_PROXY_URL unset above if you use this.
# EXPO_PUBLIC_UPS_CLIENT_ID=your-ups-client-id
# EXPO_PUBLIC_UPS_CLIENT_SECRET=your-ups-client-secret
# EXPO_PUBLIC_FEDEX_CLIENT_ID=your-fedex-client-id
# EXPO_PUBLIC_FEDEX_CLIENT_SECRET=your-fedex-client-secret
# EXPO_PUBLIC_DHL_API_KEY=your-dhl-api-key
